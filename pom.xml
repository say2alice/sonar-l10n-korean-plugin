<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.way2java.sonar.l10n</groupId>
  <artifactId>sonar-l10n-korean-plugin</artifactId>
  <version>26.11.0</version>
  <packaging>sonar-plugin</packaging>

  <name>Korean Pack</name>
  <description>Language pack for Korean</description>
  <url>https://github.com/say2alice/sonar-l10n-korean-plugin</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>GNU LGPL v3</name>
      <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- 공개 주소는 GitHub 미러 저장소입니다. 원본 저장소는 GitLab에 있고 미러로 옮겨집니다(문서 저장소 ADR-0023) -->
  <scm>
    <connection>scm:git:https://github.com/say2alice/sonar-l10n-korean-plugin.git</connection>
    <url>https://github.com/say2alice/sonar-l10n-korean-plugin</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/say2alice/sonar-l10n-korean-plugin/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 빌드 JDK는 Toolchains로 지정하고, 바이트코드는 sonar-plugin-api와 같은 17로 둡니다 -->
    <jdk.toolchain.version>25</jdk.toolchain.version>
    <maven.compiler.release>17</maven.compiler.release>

    <sonar.plugin.key>l10nkorean</sonar.plugin.key>
    <sonar.plugin.class>net.way2java.sonar.l10n.korean.KoreanPackPlugin</sonar.plugin.class>
    <!-- 지원 하한인 Community Build 26.1의 API 버전 -->
    <sonar.plugin.api.min.version>13.4.3.4290</sonar.plugin.api.min.version>

    <!-- 번역 기준 원본. 영문 번들 생성기와 기준 태그 검사가 읽습니다(문서 저장소 ADR-0015) -->
    <sonarqube.webapp.tag>sqcb-26.11.0</sonarqube.webapp.tag>
    <sonarqube.webapp.messages.path>libs/sq-server-commons/src/l10n/default.ts</sonarqube.webapp.messages.path>
    <!-- true이면 미번역 키가 있을 때 빌드가 실패합니다. CI는 main 대상 병합 요청에서 켭니다(문서 저장소 ADR-0014) -->
    <translation.requireComplete>false</translation.requireComplete>

    <sonar-plugin-api.version>14.1.0.5543</sonar-plugin-api.version>
    <!-- 플러그인 테스트의 실행 환경인 sonar-plugin-api-impl의 버전 -->
    <sonarqube.version>26.11.0.134175</sonarqube.version>
    <icu4j.version>78.3</icu4j.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <sonar-packaging-maven-plugin.version>2.0.0.3035</sonar-packaging-maven-plugin.version>
    <maven-toolchains-plugin.version>3.3.0</maven-toolchains-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <!-- sonar-plugin 패키징이 버전을 정하지 않아, 고정하지 않으면 Maven 4 전용 버전을 찾다가 경고를 냅니다 -->
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <sonar-maven-plugin.version>5.9.0.7382</sonar-maven-plugin.version>

    <!-- SonarQube Cloud 분석 대상. 서버 주소와 토큰은 CI/CD 변수 SONAR_HOST_URL, SONAR_TOKEN으로 받습니다(문서 저장소 ADR-0023) -->
    <sonar.organization>say2alice</sonar.organization>
    <sonar.projectKey>say2alice_sonar-l10n-korean-plugin</sonar.projectKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sonarsource.api.plugin</groupId>
      <artifactId>sonar-plugin-api</artifactId>
      <version>${sonar-plugin-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.sonarsource.sonarqube</groupId>
      <artifactId>sonar-plugin-api-impl</artifactId>
      <version>${sonarqube.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- 번역문의 ICU 메시지 구문을 검사합니다(NFR-QL-03) -->
      <groupId>com.ibm.icu</groupId>
      <artifactId>icu4j</artifactId>
      <version>${icu4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <sonarqube.webapp.tag>${sonarqube.webapp.tag}</sonarqube.webapp.tag>
              <translation.requireComplete>${translation.requireComplete}</translation.requireComplete>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <!-- CI가 org.sonarsource.scanner.maven:sonar-maven-plugin:sonar로 실행합니다. 버전은 여기서 정합니다 -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>${jdk.toolchain.version}</version>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
        <artifactId>sonar-packaging-maven-plugin</artifactId>
        <version>${sonar-packaging-maven-plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <pluginKey>${sonar.plugin.key}</pluginKey>
          <pluginClass>${sonar.plugin.class}</pluginClass>
          <pluginName>Korean Pack</pluginName>
          <pluginDescription>Language pack for Korean</pluginDescription>
          <pluginApiMinVersion>${sonar.plugin.api.min.version}</pluginApiMinVersion>
        </configuration>
      </plugin>

      <plugin>
        <!-- 영문 번들 생성기, 상용 번들 동기화 도구, 번역 보조 도구를 Toolchains의 JDK로 실행합니다. 빌드 단계에는 묶지 않고 scripts/의 스크립트가 호출합니다 -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <executable>java</executable>
          <classpathScope>test</classpathScope>
        </configuration>
        <executions>
          <execution>
            <id>generate</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.generator.EnglishBundleGenerator</argument>
                <argument>generate</argument>
                <argument>${sonarqube.webapp.tag}</argument>
                <argument>${sonarqube.webapp.messages.path}</argument>
                <argument>${project.basedir}/src/main/resources/org/sonar/l10n</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>diff</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.generator.EnglishBundleGenerator</argument>
                <argument>diff</argument>
                <argument>${sonarqube.webapp.messages.path}</argument>
                <argument>${diff.from}</argument>
                <argument>${diff.to}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>commercial-sync</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.generator.CommercialBundleSync</argument>
                <argument>sync</argument>
                <argument>${project.basedir}/translation/commercial</argument>
                <argument>${project.basedir}/src/main/resources/org/sonar/l10n</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>commercial-update</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.generator.CommercialBundleSync</argument>
                <argument>update</argument>
                <argument>${commercial.jar}</argument>
                <argument>${project.basedir}/translation/commercial</argument>
                <argument>${project.basedir}/src/main/resources/org/sonar/l10n</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sheet</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.TranslationSheet</argument>
                <argument>${sheet.unit}</argument>
                <argument>${sheet.reference}</argument>
                <argument>${sheet.prefixes}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>compare</id>
            <configuration>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>net.way2java.sonar.l10n.korean.KoreanPackComparison</argument>
                <argument>${sheet.unit}</argument>
                <argument>${sheet.reference}</argument>
                <argument>${sheet.prefixes}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
